# --- 🔐 보안 (절대 올리면 안 됨!) ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# --- 🐍 Backend (Python) ---
# 가상환경 폴더
venv/
env/
.venv/

# 컴파일된 파이썬 파일 (필요 없음)
__pycache__/
*.py[cod]
*$py.class

# 데이터베이스 (로컬 DB는 나만 갖고 있어야 함)
*.db
*.sqlite3
backend/music_review.db

# 업로드된 파일 (MP3 등 용량 큰 파일 제외)
backend/uploads/
uploads/

# --- ⚛️ Frontend (Next.js/Node) ---
# 라이브러리 (package.json만 있으면 됨)
node_modules/
frontend/node_modules/

# 빌드 결과물
.next/
out/
build/
dist/

# Next.js 디버그 로그
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- 🖥️ 운영체제 및 에디터 ---
.DS_Store
Thumbs.db
.vscode/
.idea/